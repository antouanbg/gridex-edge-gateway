[Unit]
Description=GrideX EMS Edge service for Radxa ROCK Pi E
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/gridex/gridex-rockpie.env
ExecStart=/usr/local/bin/gridex_rockpie_service
Restart=always
RestartSec=3
User=gridex
Group=gridex
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gridex /var/log/gridex
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
