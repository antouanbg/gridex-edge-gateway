# STE-261L is reachable only through the OT Ethernet interface.
GRIDEX_PCS_HOST=bess-controller.ot.internal
GRIDEX_PCS_PORT=3200
GRIDEX_PCS_UNIT_ID=1
GRIDEX_PCS_TIMEOUT_MS=800
GRIDEX_TICK_MS=1000

# OpenRemote connects here; this is not the vendor port 3200.
GRIDEX_NORTHBOUND_BIND=0.0.0.0
GRIDEX_NORTHBOUND_PORT=1502
GRIDEX_NORTHBOUND_UNIT_ID=1

# Optional site-level caps. Leave empty to use only the live BMS limits 127/128.
GRIDEX_MAX_CHARGE_KW=
GRIDEX_MAX_DISCHARGE_KW=

# Keep all writes locked until commissioning confirms these three items.
GRIDEX_APPROVE_ADDRESSING=0
GRIDEX_APPROVE_POWER_SIGN=0
GRIDEX_APPROVE_SCALING=0
# The vendor table says Int32 but does not define the two-word order.
GRIDEX_APPROVE_INT32_WORD_ORDER=0
GRIDEX_INT32_HIGH_WORD_FIRST=1

# OLIMEX ESP32-EVB nodes are polled over isolated OT Ethernet. Each node
# exposes the canonical map on Modbus TCP 1502, unit ID 1. On a deployed ROCK
# Pi this file is root-owned at /etc/gridex/gridex-rockpie.env; use Site Router
# DHCP reservations or OT DNS names so a normal reboot never changes an entry.
# Do not put real site endpoints into this example or Git.
GRIDEX_NODE_ENDPOINTS=node-01.ot.internal:1502,node-02.ot.internal:1502
GRIDEX_NODE_TIMEOUT_MS=400
GRIDEX_NODE_POLL_MS=500

# Private MQTT telemetry and health only. The broker is reachable through the
# Site Router VPN; `mqtt://`, public brokers and MQTT command subscriptions are
# not supported. Keep secrets outside this file and outside Git.
GRIDEX_SITE_ID=<site-id>
GRIDEX_GATEWAY_ID=<gateway-id>
GRIDEX_MQTT_BROKER_URL=mqtts://mqtt.internal:8883
GRIDEX_MQTT_TOPIC_PREFIX=gridex/v1
GRIDEX_MQTT_CLIENT_ID=<unique-edge-client-id>
GRIDEX_MQTT_USERNAME=
GRIDEX_MQTT_PASSWORD_FILE=/etc/gridex/secrets/mqtt-password
GRIDEX_MQTT_CA_FILE=/etc/gridex/certs/private-mqtt-ca.pem
# Optional mutual TLS pair; set both values or leave both empty.
GRIDEX_MQTT_CLIENT_CERT_FILE=
GRIDEX_MQTT_CLIENT_KEY_FILE=
GRIDEX_HEALTH_PUBLISH_SECONDS=10
GRIDEX_NODE_TELEMETRY_PUBLISH_SECONDS=2
